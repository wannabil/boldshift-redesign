/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-__INLINE_HASH__'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self' mailto:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: DENY

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Preview deployments on pages.dev must not compete with the real domain in Google.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
